<RCC>
    <qresource prefix="/">
        <file alias="app_icon.png">resources/app_icon.png</file>
    </qresource>
    <qresource prefix="/themes">
        <file alias="dark.qss">resources/themes/dark.qss</file>
        <file alias="light.qss">resources/themes/light.qss</file>
    </qresource>
</RCC>
